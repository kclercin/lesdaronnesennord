---
import { getCollection } from 'astro:content'
import Layout from '../components/Layout.astro'
import LogoCircle from '../components/icons/LogoCircle.astro'
import Sparkle from '../components/icons/Sparkle.astro'
import { ICONES } from '../components/icons'
import { site } from '../lib/site'
import { nosAteliers } from '../lib/pages/nos-ateliers'
import CarteAtelier from '../components/sections/CarteAtelier.astro'

const { seo, hero, cercleVertueux, transmission, pourTous, catalogue, cta } = nosAteliers

const RAYONS = [
  '240px 18px 220px 18px / 18px 220px 18px 240px',
  '18px 220px 18px 240px / 240px 18px 220px 18px',
  '220px 18px 240px 18px / 18px 240px 18px 220px',
]

const ateliers = (await getCollection('ateliers')).sort((a, b) => a.data.ordre - b.data.ordre)
---

<Layout titre={seo.titre} description={seo.description} active="ateliers">
  <section class="hero">
    <div class="hero-grille">
      <div class="hero-logo-wrap">
        <LogoCircle label={hero.cercleLabel} fontSize={26} color="#1B1A17" />
      </div>
      <div>
        <div class="hero-kicker" set:html={hero.kicker} />
        <h1 class="hero-titre">{hero.titre}</h1>
        <p class="hero-texte" set:html={hero.texte} />
        <a
          href={site.reservationAteliers}
          target="_blank"
          rel="noopener noreferrer"
          class="dc-btn dc-btn-dark hero-cta"
          set:html={hero.ctaLabel}
        />
      </div>
    </div>
  </section>

  <section class="cercle">
    <div class="cercle-sparkle">
      <Sparkle size={96} color="rgba(232,190,54,.5)" />
    </div>
    <div class="cercle-conteneur">
      <div class="cercle-intro">
        <div class="cercle-kicker">{cercleVertueux.kicker}</div>
        <h2 class="cercle-titre">{cercleVertueux.titre}</h2>
        <p class="cercle-texte">{cercleVertueux.texte}</p>
      </div>
      <div class="cercle-grille">
        {cercleVertueux.cartes.map((carte) => {
          const Icone = ICONES[carte.icone]
          return (
            <div class="cercle-carte">
              <div class="cercle-carte-icone"><Icone /></div>
              <h3 class="cercle-carte-titre">{carte.titre}</h3>
              <p class="cercle-carte-texte">{carte.texte}</p>
            </div>
          )
        })}
      </div>
    </div>
  </section>

  <section class="transmission">
    <div class="transmission-conteneur">
      <div class="transmission-entete">
        <div class="transmission-kicker">{transmission.kicker}</div>
        <h2 class="transmission-titre">{transmission.titre}</h2>
        <p class="transmission-texte">{transmission.texte}</p>
      </div>
      <div class="transmission-grille">
        {transmission.cartes.map((carte, i) => {
          const Icone = ICONES[carte.icone]
          return (
            <article class="transmission-carte" style={`border-radius:${RAYONS[i]}`}>
              <div class="transmission-carte-icone"><Icone /></div>
              <h3 class="transmission-carte-titre">{carte.titre}</h3>
              <p class="transmission-carte-texte">{carte.texte}</p>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section class="pour-tous">
    <div class="pour-tous-conteneur">
      <div class="pour-tous-entete">
        <div class="pour-tous-kicker" set:html={pourTous.kicker} />
        <h2 class="pour-tous-titre">{pourTous.titre}</h2>
        <p class="pour-tous-texte">{pourTous.texte}</p>
      </div>
      <div class="pour-tous-grille">
        {pourTous.cartes.map((carte) => {
          const Icone = ICONES[carte.icone]
          return (
            <article class="pour-tous-carte">
              <div class="pour-tous-carte-icone"><Icone /></div>
              <h3 class="pour-tous-carte-titre">{carte.titre}</h3>
              <p class="pour-tous-carte-texte">{carte.texte}</p>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section id="ateliers" class="catalogue">
    <div class="catalogue-conteneur">
      <div class="catalogue-entete">
        <div class="catalogue-kicker">{catalogue.kicker}</div>
        <h2 class="catalogue-titre">{catalogue.titre}</h2>
      </div>
      {ateliers.map((atelier) => (
        <CarteAtelier
          atelier={atelier}
          reservationHref={site.reservationAteliers}
          labelDeroule={catalogue.labelDeroule}
          labelDerouleOuvert={catalogue.labelDerouleOuvert}
          titreDeroule={catalogue.titreDeroule}
          titreRepartez={catalogue.titreRepartez}
          labelReservation={catalogue.labelReservation}
        />
      ))}
    </div>
  </section>

  <section class="cta">
    <div class="cta-carte">
      <div class="cta-sparkle-1">
        <Sparkle size={34} color="#1B1A17" />
      </div>
      <div class="cta-sparkle-2">
        <Sparkle size={34} color="#1B1A17" />
      </div>
      <h2 class="cta-titre" set:html={cta.titre} />
      <p class="cta-texte">{cta.texte}</p>
      <div class="cta-bouton-wrap">
        <a
          href={site.reservationAteliers}
          target="_blank"
          rel="noopener noreferrer"
          class="dc-btn dc-btn-dark cta-bouton"
        >
          {cta.labelBouton}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===================== HERO ===================== */
  .hero {
    padding: clamp(40px, 6vw, 80px) clamp(20px, 5vw, 56px) clamp(48px, 6vw, 84px);
    background: var(--creme);
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--encre-08);
  }
  .hero-grille {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
  }
  .hero-logo-wrap {
    width: min(450px, 100%);
    aspect-ratio: 1;
    margin: 0 auto;
  }
  .hero-kicker {
    font-family: var(--manuscrit);
    font-size: 34px;
    color: var(--or-fonce);
    transform: rotate(-1deg);
    line-height: 1;
  }
  .hero-titre {
    margin: 6px 0 0;
    font-family: var(--display);
    text-transform: uppercase;
    font-weight: 400;
    font-size: clamp(50px, 8vw, 96px);
    line-height: 0.9;
    letter-spacing: 0.5px;
    color: var(--encre);
  }
  .hero-texte {
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--texte);
    max-width: 46ch;
  }
  .hero-cta {
    display: inline-block;
    margin-top: 26px;
    font-weight: 700;
    font-size: 16px;
    padding: 15px 30px;
  }

  @media (max-width: 860px) {
    .hero-grille {
      grid-template-columns: 1fr;
    }
    .hero-titre {
      font-size: 64px;
    }
  }

  /* ===================== CERCLE VERTUEUX ===================== */
  .cercle {
    padding: clamp(48px, 6vw, 96px) clamp(20px, 5vw, 56px);
    background: var(--encre);
    color: var(--creme);
    position: relative;
    overflow: hidden;
  }
  .cercle-sparkle {
    position: absolute;
    top: -20px;
    right: 5%;
    --r: 8deg;
    animation: floaty 7s ease-in-out infinite;
  }
  .cercle-conteneur {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }
  .cercle-intro {
    max-width: 680px;
  }
  .cercle-kicker {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 15px;
    color: var(--or-clair);
  }
  .cercle-titre {
    margin: 10px 0 0;
    font-family: var(--manuscrit);
    font-weight: 600;
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1;
    color: var(--or-clair);
  }
  .cercle-texte {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--creme-78);
  }
  .cercle-grille {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 40px;
  }
  .cercle-carte {
    border: 1.5px solid var(--or-40);
    border-radius: 18px;
    padding: 26px 24px;
    background: var(--or-06);
  }
  .cercle-carte-icone {
    margin-bottom: 12px;
  }
  .cercle-carte-titre {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--or-clair);
  }
  .cercle-carte-texte {
    margin: 8px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    /* alpha .74 sur la crème : ne correspond à aucun token (.72/.78/.80 seulement) */
    color: rgba(251, 246, 233, 0.74);
  }

  @media (max-width: 860px) {
    .cercle-grille {
      grid-template-columns: 1fr;
    }
  }

  /* ===================== TRANSMISSION ===================== */
  .transmission {
    padding: clamp(48px, 6vw, 90px) clamp(20px, 5vw, 56px);
    background: var(--blanc);
    border-bottom: 1px solid var(--encre-08);
  }
  .transmission-conteneur {
    max-width: 1120px;
    margin: 0 auto;
  }
  .transmission-entete {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }
  .transmission-kicker {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 15px;
    color: var(--or);
  }
  .transmission-titre {
    margin: 10px 0 0;
    font-family: var(--manuscrit);
    font-weight: 600;
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1;
  }
  .transmission-texte {
    margin: 14px auto 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--texte-doux);
    max-width: 52ch;
  }
  .transmission-grille {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 44px;
  }
  .transmission-carte {
    background: var(--creme);
    border: 2.5px solid var(--encre);
    padding: 32px 28px;
  }
  .transmission-carte-icone {
    margin-bottom: 14px;
  }
  .transmission-carte-titre {
    margin: 0;
    font-family: var(--manuscrit);
    font-weight: 600;
    font-size: 27px;
    line-height: 1;
  }
  .transmission-carte-texte {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--texte);
  }

  @media (max-width: 860px) {
    .transmission-grille {
      grid-template-columns: 1fr;
    }
  }

  /* ===================== POUR TOUS ===================== */
  .pour-tous {
    padding: clamp(48px, 6vw, 90px) clamp(20px, 5vw, 56px);
    background: var(--creme);
    border-bottom: 1px solid var(--encre-08);
  }
  .pour-tous-conteneur {
    max-width: 1120px;
    margin: 0 auto;
  }
  .pour-tous-entete {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }
  .pour-tous-kicker {
    font-family: var(--manuscrit);
    font-size: 32px;
    color: var(--or-fonce);
    transform: rotate(-2deg);
    line-height: 1;
  }
  .pour-tous-titre {
    margin: 8px 0 0;
    font-family: var(--display);
    text-transform: uppercase;
    font-weight: 400;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1;
    letter-spacing: 0.5px;
  }
  .pour-tous-texte {
    margin: 14px auto 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--texte-doux);
    max-width: 50ch;
  }
  .pour-tous-grille {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 44px;
  }
  .pour-tous-carte {
    background: var(--blanc);
    border: 2px solid var(--encre);
    border-radius: 22px;
    padding: 30px 26px;
  }
  .pour-tous-carte-icone {
    margin-bottom: 14px;
  }
  .pour-tous-carte-titre {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }
  .pour-tous-carte-texte {
    margin: 10px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--texte);
  }

  @media (max-width: 860px) {
    .pour-tous-grille {
      grid-template-columns: 1fr;
    }
  }

  /* ===================== CATALOGUE ===================== */
  .catalogue {
    padding: clamp(48px, 6vw, 90px) clamp(20px, 5vw, 56px);
    background: var(--blanc);
    border-bottom: 1px solid var(--encre-08);
  }
  .catalogue-conteneur {
    max-width: 1120px;
    margin: 0 auto;
  }
  .catalogue-entete {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }
  .catalogue-kicker {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 15px;
    color: var(--or);
  }
  .catalogue-titre {
    margin: 10px 0 0;
    font-family: var(--manuscrit);
    font-weight: 600;
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1;
  }

  /* ===================== CTA BAND ===================== */
  .cta {
    padding: clamp(44px, 5vw, 80px) clamp(20px, 5vw, 56px);
    background: var(--creme);
  }
  .cta-carte {
    max-width: 1100px;
    margin: 0 auto;
    /* deuxième teinte du dégradé absente de tokens.css — la plus proche (--or-sombre) diffère (#C49C22) */
    background: linear-gradient(150deg, var(--or-doux), #c09a20);
    border-radius: 40px;
    padding: clamp(34px, 5vw, 60px);
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .cta-sparkle-1 {
    position: absolute;
    top: 18px;
    left: 30px;
    --r: -8deg;
    animation: floaty 6s ease-in-out infinite;
  }
  .cta-sparkle-2 {
    position: absolute;
    bottom: 20px;
    right: 40px;
    --r: 8deg;
    animation: floaty 7s ease-in-out infinite 0.5s;
  }
  .cta-titre {
    margin: 0;
    font-family: var(--manuscrit);
    font-size: clamp(40px, 5.5vw, 64px);
    line-height: 1;
    color: var(--encre);
  }
  .cta-texte {
    margin: 12px auto 0;
    max-width: 42ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--texte-or);
  }
  .cta-bouton-wrap {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
  .cta-bouton {
    font-size: 16px;
    padding: 15px 30px;
  }
</style>
