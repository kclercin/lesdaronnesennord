---
import { Image } from 'astro:assets'
import Layout from '../components/Layout.astro'
import LogoCircle from '../components/icons/LogoCircle.astro'
import Sparkle from '../components/icons/Sparkle.astro'
import Bottles from '../components/icons/Bottles.astro'
import Plant from '../components/icons/Plant.astro'
import { ICONES } from '../components/icons'
import { CLASSES_BOUTON } from '../lib/boutons'
import { accueil } from '../lib/pages/accueil'
import equipe from '../images/equipe-daronnes.png'

const { seo, hero, activites, engagements, smd, apropos, cta } = accueil

const RAYONS = [
  '240px 18px 220px 18px / 18px 220px 18px 240px',
  '18px 220px 18px 240px / 240px 18px 220px 18px',
  '220px 18px 240px 18px / 18px 240px 18px 220px',
]
---

<Layout titre={seo.titre} description={seo.description} active="accueil">
  <section id="bonjour" class="hero">
    <div class="hero-deco hero-deco-bottles">
      <Bottles scale={0.7} />
    </div>
    <div class="hero-deco hero-deco-plant">
      <Plant />
    </div>
    <div class="hero-halo"></div>
    <div class="hero-inner rc-rise">
      <div class="hero-kicker">
        <Sparkle size={26} color="#E8BE36" />
        {hero.kicker}
      </div>
      <h1 class="hero-titre">
        {hero.titreAvant}<span class="hero-titre-accent">{hero.titreAccent}</span>{hero.titreApres}
      </h1>
      <p class="hero-texte" set:html={hero.texte} />
      <div class="hero-cta-wrap">
        {hero.cta.map((c) => (
          <a href={c.href} class={`hero-cta ${CLASSES_BOUTON[c.style]}`} set:html={c.label} />
        ))}
      </div>
    </div>
  </section>

  <section id="activites" class="activites">
    <div class="activites-inner">
      <div class="activites-kicker">{activites.kicker}</div>
      <h2 class="activites-titre">{activites.titre}</h2>
      <p class="activites-texte">{activites.texte}</p>

      <div class="activites-cercles">
        {activites.cercles.map((c) => (
          <a href={c.href} class="activites-cercle dc-lift">
            <div class="activites-cercle-logo">
              <LogoCircle label={c.label} fontSize={c.taillePolice} color="#1B1A17" />
            </div>
            <span class="activites-cercle-texte">{c.texte}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="engagements" class="engagements">
    <div class="engagements-inner">
      <div class="engagements-entete">
        <div class="engagements-kicker">{engagements.kicker}</div>
        <h2 class="engagements-titre">{engagements.titre}</h2>
        <p class="engagements-texte">{engagements.texte}</p>
      </div>

      <div class="engagements-grille">
        {engagements.cartes.map((carte, i) => {
          const Icone = ICONES[carte.icone]
          return (
            <article class="carte" style={`border-radius:${RAYONS[i]}`}>
              <div class="carte-numero">{carte.numero}</div>
              <div class="carte-icone"><Icone /></div>
              <h3 class="carte-titre">{carte.titre}</h3>
              {carte.paragraphes.map((p) => (
                <p class="carte-texte" set:html={p} />
              ))}
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section id="smd" class="smd">
    <div class="smd-sparkle">
      <Sparkle size={120} color="#E8BE36" />
    </div>
    <div class="smd-inner">
      <div class="smd-grille">
        <div>
          <div class="smd-kicker">{smd.kicker}</div>
          <h2 class="smd-titre">{smd.titre}</h2>
          <p class="smd-texte">{smd.texte}</p>
          <div class="smd-citation">{smd.citation}</div>
        </div>
        <div class="smd-cartes">
          {smd.cartes.map((carte) => {
            const Icone = ICONES[carte.icone]
            return (
              <div class="smd-carte">
                <div class="smd-carte-icone"><Icone /></div>
                <h4 class="smd-carte-titre">{carte.titre}</h4>
                <p class="smd-carte-texte">{carte.texte}</p>
              </div>
            )
          })}
        </div>
      </div>
    </div>
  </section>

  <section id="apropos" class="apropos">
    <div class="apropos-grille">
      <div class="apropos-image-wrap">
        <div class="apropos-halo"></div>
        <div class="apropos-frame">
          <div class="apropos-frame-border"></div>
          <Image src={equipe} alt={apropos.imageAlt} class="apropos-photo" />
        </div>
      </div>
      <div>
        <div class="apropos-kicker">{apropos.kicker}</div>
        <h2 class="apropos-titre">{apropos.titre}</h2>
        {apropos.paragraphes.map((p) => (
          <p class="apropos-texte" set:html={p} />
        ))}
        <div class="apropos-etiquettes">
          {apropos.etiquettes.map((t) => (
            <span class="apropos-etiquette">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta-carte">
      <div class="cta-sparkle-1">
        <Sparkle size={34} color="#1B1A17" />
      </div>
      <div class="cta-sparkle-2">
        <Sparkle size={34} color="#1B1A17" />
      </div>
      <h2 class="cta-titre">{cta.titre}</h2>
      <p class="cta-texte">{cta.texte}</p>
      <div class="cta-bouton-wrap">
        {cta.boutons.map((b) => (
          <a href={b.href} class={`cta-bouton ${CLASSES_BOUTON[b.style]}`} set:html={b.label} />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===================== HERO ===================== */
  .hero {
    position: relative;
    padding: clamp(48px, 7vw, 96px) clamp(20px, 5vw, 56px) clamp(56px, 7vw, 104px);
    text-align: center;
    overflow: hidden;
  }
  .hero-deco {
    position: absolute;
  }
  .hero-deco-bottles {
    left: 6%;
    top: 22%;
    transform: rotate(-8deg);
    opacity: 0.9;
  }
  .hero-deco-plant {
    right: 5%;
    bottom: 14%;
    transform: rotate(6deg);
  }
  .hero-halo {
    position: absolute;
    left: 50%;
    top: 8%;
    transform: translateX(-50%);
    width: min(560px, 70vw);
    height: min(560px, 70vw);
    background: radial-gradient(circle, rgba(214, 178, 52, 0.35), rgba(214, 178, 52, 0) 70%);
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
  }
  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--manuscrit);
    font-size: 32px;
    color: var(--or-fonce);
    transform: rotate(-2deg);
  }
  .hero-titre {
    margin: 14px auto 0;
    font-size: clamp(48px, 8vw, 92px);
    line-height: 0.95;
    font-weight: 600;
    letter-spacing: -1.5px;
    max-width: 14ch;
  }
  .hero-titre-accent {
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--or-fonce);
  }
  .hero-texte {
    margin: 24px auto 0;
    max-width: 36em;
    font-size: 19px;
    line-height: 1.65;
    color: var(--texte);
  }
  .hero-cta-wrap {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
  .hero-cta {
    font-size: 16px;
  }
  .hero-cta-wrap .hero-cta:nth-child(1) {
    padding: 15px 28px;
  }
  .hero-cta-wrap .hero-cta:nth-child(2) {
    padding: 14px 28px;
  }

  @media (max-width: 860px) {
    .hero-deco {
      display: none;
    }
    .hero-titre {
      font-size: 44px;
    }
  }

  /* ===================== NOS ACTIVITÉS ===================== */
  .activites {
    background: linear-gradient(160deg, var(--or-doux), var(--or-sombre));
    padding: clamp(40px, 6vw, 76px) clamp(20px, 5vw, 56px);
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--encre-12);
    border-bottom: 1px solid var(--encre-12);
  }
  .activites-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .activites-kicker {
    font-family: var(--manuscrit);
    font-size: 30px;
    /* teinte propre à cette section, sans équivalent dans tokens.css */
    color: #5b4708;
    transform: rotate(-2deg);
  }
  .activites-titre {
    margin: 12px 0 0;
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(48px, 9vw, 104px);
    line-height: 0.9;
    letter-spacing: 1px;
    color: var(--encre);
  }
  .activites-texte {
    margin: 16px 0 0;
    max-width: 46ch;
    font-size: 18px;
    line-height: 1.6;
    /* teinte propre à cette section, sans équivalent dans tokens.css */
    color: #3a2f08;
  }
  .activites-cercles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 4vw, 48px);
    margin: clamp(20px, 3vw, 36px) auto 0;
    max-width: 980px;
  }
  .activites-cercle {
    text-decoration: none;
    color: var(--encre);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .activites-cercle-logo {
    position: relative;
    width: 210px;
    max-width: 60vw;
    aspect-ratio: 1;
  }
  .activites-cercle-texte {
    font-size: 14px;
    font-weight: 500;
    /* teinte propre à cette section, sans équivalent dans tokens.css */
    color: #3a2f08;
    text-align: center;
    max-width: 22ch;
  }

  @media (max-width: 860px) {
    .activites-titre {
      font-size: 64px;
    }
    .activites-cercles {
      grid-template-columns: 1fr;
    }
  }

  /* ===================== ENGAGEMENTS ===================== */
  .engagements {
    padding: clamp(48px, 6vw, 90px) clamp(20px, 5vw, 56px);
    background: var(--blanc);
    border-top: 1px solid var(--encre-08);
    border-bottom: 1px solid var(--encre-08);
  }
  .engagements-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .engagements-entete {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 8px;
  }
  .engagements-kicker {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 15px;
    color: var(--or);
  }
  .engagements-titre {
    margin: 10px 0 0;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.5px;
    white-space: pre-line;
  }
  .engagements-texte {
    margin: 16px auto 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--texte-doux);
    max-width: 44ch;
  }
  .engagements-grille {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    margin-top: 46px;
  }
  .carte {
    position: relative;
    background: var(--creme);
    border: 2.5px solid var(--encre);
    padding: 34px 30px 30px;
  }
  .carte-numero {
    font-family: var(--display);
    font-size: 46px;
    color: var(--or);
    line-height: 1;
  }
  .carte-icone {
    margin: 12px 0 14px;
  }
  .carte-titre {
    margin: 0;
    font-family: var(--manuscrit);
    font-weight: 600;
    font-size: 30px;
    line-height: 1;
  }
  .carte-texte {
    margin: 12px 0 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--texte);
  }
  .carte-texte + .carte-texte {
    margin-top: 10px;
  }

  @media (max-width: 860px) {
    .engagements-grille {
      grid-template-columns: 1fr;
    }
  }

  /* ===================== SMD ===================== */
  .smd {
    padding: clamp(48px, 6vw, 96px) clamp(20px, 5vw, 56px);
    background: var(--encre);
    color: var(--creme);
    position: relative;
    overflow: hidden;
  }
  .smd-sparkle {
    position: absolute;
    top: -40px;
    right: 4%;
    opacity: 0.5;
  }
  .smd-inner {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }
  .smd-grille {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .smd-kicker {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 15px;
    color: var(--or-clair);
  }
  .smd-titre {
    margin: 12px 0 0;
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.5px;
    white-space: pre-line;
  }
  .smd-texte {
    margin: 22px 0 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--creme-78);
    max-width: 36ch;
  }
  .smd-citation {
    font-family: var(--manuscrit);
    font-size: 30px;
    color: var(--or-clair);
    margin-top: 22px;
    transform: rotate(-2deg);
  }
  .smd-cartes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .smd-carte {
    border: 1.5px solid var(--or-40);
    border-radius: 16px;
    padding: 22px 20px;
    background: var(--or-06);
  }
  .smd-carte-icone {
    margin-bottom: 12px;
  }
  .smd-carte-titre {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--or-clair);
  }
  .smd-carte-texte {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--creme-72);
  }

  @media (max-width: 860px) {
    .smd-grille {
      grid-template-columns: 1fr;
    }
  }

  /* ===================== À PROPOS ===================== */
  .apropos {
    padding: clamp(48px, 6vw, 90px) clamp(20px, 5vw, 56px);
    background: var(--blanc);
    border-bottom: 1px solid var(--encre-08);
  }
  .apropos-grille {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .apropos-image-wrap {
    position: relative;
  }
  .apropos-halo {
    position: absolute;
    inset: -10% -8% -14% -8%;
    /* même teinte que --or-doux (216,180,58) mais tokens.css ne stocke pas
       le triplet rgb séparément pour composer une alpha ici */
    background: radial-gradient(60% 60% at 50% 55%, rgba(216, 180, 58, 0.55), rgba(216, 180, 58, 0) 70%);
    filter: blur(28px);
    z-index: 0;
    pointer-events: none;
  }
  .apropos-frame {
    background: linear-gradient(160deg, var(--or-doux), var(--or-sombre));
    border-radius: 36px 60px 36px 60px / 60px 36px 60px 36px;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    /* teinte propre à cette ombre, sans équivalent dans tokens.css */
    box-shadow: 0 28px 56px -30px rgba(166, 131, 20, 0.6);
  }
  .apropos-frame-border {
    position: absolute;
    inset: 16px;
    /* alpha .25 sur l'encre : ni --encre-12 ni --encre-14 ne correspondent */
    border: 2px solid rgba(27, 26, 23, 0.25);
    border-radius: 26px 50px 26px 50px / 50px 26px 50px 26px;
    pointer-events: none;
  }
  .apropos-photo {
    position: relative;
    z-index: 1;
    width: 92%;
    height: 92%;
    object-fit: contain;
    object-position: center bottom;
    /* alpha .18 sur l'encre : ne correspond à aucune transparence de tokens.css */
    filter: drop-shadow(0 12px 20px rgba(27, 26, 23, 0.18));
  }
  .apropos-kicker {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 15px;
    color: var(--or);
  }
  .apropos-titre {
    margin: 10px 0 0;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.5px;
    white-space: pre-line;
  }
  .apropos-texte {
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--texte);
  }
  .apropos-texte + .apropos-texte {
    margin-top: 14px;
  }
  .apropos-etiquettes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .apropos-etiquette {
    font-family: var(--manuscrit);
    font-size: 22px;
    /* teintes propres à cette étiquette, sans équivalent dans tokens.css */
    background: #f3e7c2;
    border: 1.5px solid var(--or);
    color: #8a6c12;
    padding: 4px 18px;
    border-radius: 40px;
  }

  @media (max-width: 860px) {
    .apropos-grille {
      grid-template-columns: 1fr;
    }
  }

  /* ===================== CTA BAND ===================== */
  .cta {
    padding: clamp(44px, 5vw, 80px) clamp(20px, 5vw, 56px);
  }
  .cta-carte {
    max-width: 1100px;
    margin: 0 auto;
    /* deuxième teinte du dégradé absente de tokens.css — la plus proche (--or-sombre) diffère (#C49C22) */
    background: linear-gradient(150deg, var(--or-doux), #c09a20);
    border-radius: 40px;
    padding: clamp(34px, 5vw, 60px);
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .cta-sparkle-1 {
    position: absolute;
    top: 18px;
    left: 30px;
    --r: -8deg;
    animation: floaty 6s ease-in-out infinite;
  }
  .cta-sparkle-2 {
    position: absolute;
    bottom: 20px;
    right: 40px;
    --r: 8deg;
    animation: floaty 7s ease-in-out infinite 0.5s;
  }
  .cta-titre {
    margin: 0;
    font-family: var(--manuscrit);
    font-size: clamp(40px, 5.5vw, 66px);
    line-height: 1;
    color: var(--encre);
  }
  .cta-texte {
    margin: 12px auto 0;
    max-width: 50ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--texte-or);
  }
  .cta-bouton-wrap {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
  .cta-bouton {
    font-size: 16px;
  }
  .cta-bouton-wrap .cta-bouton:nth-child(1) {
    padding: 15px 30px;
  }
  .cta-bouton-wrap .cta-bouton:nth-child(2) {
    padding: 14px 30px;
  }
</style>
